# Where the Next.js server reaches Django. The browser never sees this.
API_URL=http://localhost:8100

# Leave blank. A value here makes the browser call Django directly, which
# turns every request cross-origin for no gain.
NEXT_PUBLIC_API_URL=

# Where a filled-in callout form goes.
#   api       - posts to Django, which stores it and emails Jack (the default)
#   whatsapp  - opens WhatsApp on his number with the details filled in,
#               for when the site is live before the backend is
NEXT_PUBLIC_CALLOUT_MODE=api
