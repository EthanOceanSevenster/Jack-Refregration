# Copy to .env. Never commit the real one.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Where callout requests are emailed. Blank means they are stored only, and
# the admin is how you see them.
NOTIFY_EMAIL=

# The business name shown in emails and the admin.
BUSINESS_NAME=Jack Refrigerator Service

# Resend goes over HTTPS, which hosts that block SMTP still allow.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=
